<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">account.invoice.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="invoice_date" position="after">
                <field name="pricelist_id" invisible="move_type != 'out_refund'"/>
            </field>
            <xpath expr="//button[@name='action_post']" position="before">
                <button name="action_update_prices" type="object"
                        string="Update Prices"
                        invisible="not show_update_pricelist"
                        class="btn-secondary"/>
            </xpath>

            <xpath expr="//div[@name='journal_div']" position="after">
                <field name="customer_credit_limit"
                       invisible="move_type not in ['in_invoice','out_invoice','out_refund']"/>
                <field name="partner_current_balance"
                       invisible="move_type not in ['in_invoice','out_invoice','out_refund']"/>
                <field name="start_date_time" invisible="move_type not in ['out_invoice','out_refund']"/>
                <field name="end_date_time" invisible="move_type not in ['out_invoice','out_refund']"/>
                <field name="sale_person_id" invisible="move_type not in ['out_invoice','out_refund']"/>
                <field name="checker_id" invisible="move_type not in ['out_invoice','out_refund']"/>
                <field name="packer_id" invisible="move_type not in ['out_invoice','out_refund']"/>
                <field name="salesmen_id" invisible="move_type not in ['out_invoice','out_refund']"/>
            </xpath>

            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <field name="ref_by" invisible="move_type not in ['out_invoice','out_refund']"/>
                <field name="product_catg_id"/>
                <field name="no_of_bags" invisible="move_type not in ['out_invoice','out_refund']"/>
                <field name="no_of_ctn" invisible="move_type not in ['out_invoice','out_refund']"/>
                <field name="party_type_id" invisible="move_type not in ['out_invoice','out_refund']"/>
            </xpath>

            <xpath expr="//field[@name='sale_person_id']" position="attributes">
                <attribute name="string">Operator</attribute>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='quantity']" position="attributes">
                <attribute name="sum">Total</attribute>
            </xpath>

            <xpath expr="(//button[@name='action_post'])[2]" position="attributes">
                <attribute name="invisible">hide_post_button or move_type == 'entry' or display_inactive_currency_warning or not show_confirm_button</attribute>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list" position="inside">
                <field name="can_edit_discount" column_invisible="1"/>
                <field name="pricelist_item_id" column_invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='price_subtotal']" position="before">
                <field name="discount_amount"
                       readonly="not can_edit_discount"
                       force_save="1"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='discount']" position="attributes">
                <attribute name="readonly">not can_edit_discount</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

            <xpath expr="//field[@name='tax_totals']" position="before">
                <field name="total_before_dis"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       class="fw-bold"
                       readonly="1"/>
                <field name="total_discount"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_move_search_inherit_sequence" model="ir.ui.view">
        <field name="name">account.move.search.inherit.sequence</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="sequence_customer" string="Customer Code"/>
            </xpath>
        </field>
    </record>

</odoo>