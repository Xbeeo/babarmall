<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_city_city_list" model="ir.ui.view">
            <field name="name">city.city.list</field>
            <field name="model">city.city</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_city_city_form" model="ir.ui.view">
            <field name="name">city.city.form</field>
            <field name="model">city.city</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_city_city_name" model="ir.actions.act_window">
            <field name="name">City</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">city.city</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create Your First City Name...!
                </p>
            </field>
        </record>

        <menuitem id="menu_action_transpoter_name"
                  name="City"
                  parent="contacts.menu_localisation"
                  action="action_city_city_name"
                  sequence="3"/>

    </data>
</odoo>
