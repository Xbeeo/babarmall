<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_brand_brand_list" model="ir.ui.view">
            <field name="name">brand.brand.list</field>
            <field name="model">brand.brand</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_brand_brand_form" model="ir.ui.view">
            <field name="name">brand.brand.form</field>
            <field name="model">brand.brand</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_brand_brand_name" model="ir.actions.act_window">
            <field name="name">Brand Name</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">brand.brand</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create Your First Brand Name...!
                </p>
            </field>
        </record>

        <menuitem id="menu_action_brand_brand"
                  name="Brand Name"
                  parent="stock.menu_warehouse_config"
                  action="action_brand_brand_name"
                  sequence="21"/>

    </data>
</odoo>
