<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="emc_view_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='vat']" position="after">
                <field name="is_credit" invisible="True"/>
                <field name="customer_credit_limit" invisible="not is_credit" required="is_credit"/>
                <field name="party_type_id" options="{'no_quick_create': True, 'no_create_edit': True,'no_open': True, 'no_create': True}"/>
            </xpath>
            <xpath expr="//field[@name='city']" position="replace">
                <field name="city_id" placeholder="City" class="o_address_city"/>
            </xpath>
            <xpath expr="//field[@name='image_1920']" position="after">
                <div class="oe_title">
                    <h1>
                        <field name="sequence_customer" invisible="supplier_rank > 0"/>
                        <field name="sequence_vendor" invisible="customer_rank > 0"/>
                    </h1>
                </div>
            </xpath>

            <xpath expr="//notebook/page[last()]" position="after">
                <page name="product" string="Products" invisible="customer_rank > 0">
                    <field name="product_ids" readonly="True">
                        <list>
                            <field name="name"/>
                        </list>
                    </field>
                </page>
            </xpath>
            <xpath expr="//field[@name='phone']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>


        </field>
    </record>


</odoo>