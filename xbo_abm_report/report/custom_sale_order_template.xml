<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_sale_order_report_template">
        <t t-call="web.html_container">
            <t t-call="xbo_abm_report.custom_sale_order_external_layout">
                <t t-foreach="docs" t-as="o">
                    <style>
                        .custom-table, .custom-table td {
                            border: 1px solid black;
                        }
                        .custom-table {
                            width: 100%;
                            border-collapse: collapse;
                        }
                    </style>

                    <!-- Ref By / Operator: kept here since it's not part of the repeating header -->
                    <div class="row" style="font-size: 11px;">
                        <div class="col-6" style="text-align: left;">
                            <t t-if="o.ref_by">
                                <strong>Ref By:</strong>
                                <t t-esc="o.ref_by"/>
                            </t>
                        </div>
                        <div class="col-6" style="text-align: right;">
                        </div>
                    </div>

                    <!--
                        NOTE: The following blocks used to appear here (start/end time,
                        customer name + date_order, party_type + order name). They now
                        live in the repeating page header inside
                        custom_external_layout_standard_solo_header, so they show on
                        every page instead of just once at the top of the document.
                    -->

                    <div class="row" style="font-size: 15px;">
                        <div class="col-6" style="text-align: left;">
                            <t t-esc="o.partner_id.city_id.name"/>
                        </div>
                        <div class="col-3" style="text-align: right;">
                        </div>
                        <div class="col-3" style="text-align: right;">
                        </div>
                    </div>
                    <div class="row" style="font-size: 15px;">
                        <div class="col-6" style="text-align: left;">
                            <t t-esc="o.partner_id.phone"/>
                        </div>
                        <div class="col-6" style="text-align: right;">
                            <t t-if="o.user_id.floor_id">
                                <strong><t t-esc="o.user_id.floor_id.name"/></strong>
                            </t>
                        </div>
                    </div>

                    <table class="custom-table" style="font-size: 11px;">
                        <thead>
                            <tr style="background-color: #c2d6d6;">
                                <th style="font-weight: bold;" class="text-center">Sr.</th>
                                <th style="font-weight: bold;" class="text-center">Item Code</th>
                                <th style="font-weight: bold;" class="text-center">Description</th>
                                <th style="font-weight: bold;" class="text-center">Qty</th>
                                <th style="font-weight: bold;" class="text-center">Rate</th>
                                <th style="font-weight: bold;" class="text-center">Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="sr_no" t-value="0"/>
                            <t t-set="total_amount" t-value="0"/>
                            <t t-set="total_qty" t-value="0"/>
                            <t t-foreach="o.order_line" t-as="line">
                                <t t-if="line.product_id.name != 'Discount'">
                                    <tr>
                                        <td class="text-center">
                                            <t t-esc="line.sr_no"/>
                                        </td>
                                        <td class="text-center">
                                            <t t-esc="line.item_code"/>
                                        </td>
                                        <td class="text-start">
                                            <t t-esc="line.product_id.display_name"/>
                                            <t t-esc="line.name"/>
                                        </td>
                                        <td class="text-center">
                                            <t t-esc="int(line.product_uom_qty)*int(line.product_uom_id.relative_factor)"/>
                                            <t t-set="total_qty" t-value="total_qty + (int(line.product_uom_qty)*int(line.product_uom_id.relative_factor))"/>
                                        </td>
                                        <td class="text-center">
                                            <t t-esc="'{:,.0f}'.format(line.custom_unit_price)"/>
                                        </td>
                                        <td class="text-center">
                                            <t t-esc="'{:,.0f}'.format(round(line.custom_unit_price*(int(line.product_uom_qty)*int(line.product_uom_id.relative_factor))))"/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>

                    </table>

                    <div style="page-break-inside: avoid; margin-top:20px;">
                        <div class="row" style="font-size: 15px;">
                            <div class="col-2" style="text-align: left;">
                            </div>
                            <div class="col-4" style="text-align: center;">
                                <strong>Net Quantity: </strong><t t-esc="int(total_qty)"/>
                            </div>
                            <div class="col-6" style="text-align: right;">
                                Gross Amount:  <strong><t t-esc="'{:,.0f}'.format(o.total_before_dis)"/></strong>
                            </div>
                        </div>
                        <div class="row" style="font-size: 15px;">
                            <div class="col-8" style="text-align: left;">
                            </div>
                            <div class="col-4" style="text-align: right;">
                                <t t-if="o.total_discount > 0">
                                    Discount: <strong> <t t-esc="'{:,.0f}'.format(o.total_discount)"/> </strong>
                                </t>
                            </div>
                        </div>
                        <div class="row" style="margin-top:30px; text-align:center;font-size: 12px;">
                            <div class="col-2">
                                <t t-esc="o.packer_id.name or ''"/>
                                <div style="border-top:1px solid #000; margin-top:5px; padding-top:5px;">
                                    <strong>Packer</strong>
                                </div>
                            </div>
                            <div class="col-1"></div>
                            <div class="col-2">
                                <t t-esc="o.checker_id.name or ''"/>
                                <div style="border-top:1px solid #000; margin-top:5px; padding-top:5px;">
                                    <strong>Checker</strong>
                                </div>
                            </div>
                            <div class="col-1"></div>
                            <div class="col-2">
                                <t t-esc="o.salesmen_id.name or ''"/>
                                <div style="border-top:1px solid #000; margin-top:5px; padding-top:5px;">
                                    <strong>Salesman</strong>
                                </div>
                            </div>
                            <div class="col-4"></div>
                        </div>
                        <strong><hr/></strong>
                        <div class="row" style="font-size: 20px;">
                            <div class="col-6" style="text-align: left;">
                                <strong>
                                    <t t-if="o.no_of_ctn > 0">
                                        <t t-esc="o.no_of_ctn"/>
                                        CTN
                                    </t>

                                    <t t-if="o.no_of_ctn > 0 and o.no_of_bags > 0">
                                        <t></t>
                                    </t>

                                    <t t-if="o.no_of_bags > 0">
                                        <t t-esc="o.no_of_bags"/>
                                        BAG
                                    </t>
                                </strong>
                            </div>

                            <div class="col-6" style="text-align: right;">
                                <strong>
                                    Rs.
                                    <t t-esc="'{:,.0f}'.format(o.amount_total)"/>
                                </strong>
                            </div>
                        </div>

                        <!-- Note -->
                        <div style="page-break-inside: avoid; margin-top: 15px;">
                            <t t-if="o.comment">
                                <div style="font-size: 13px;">
                                    <span t-esc="o.note"/>
                                </div>
                            </t>
                        </div>

                    </div>
                </t>
            </t>
        </t>

    </template>

</odoo>