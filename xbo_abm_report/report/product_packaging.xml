<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="report_packagingbarcode_inherit"
              inherit_id="product.report_packagingbarcode">
        <xpath expr="//div[@class='page']" position="replace">
            <div class="page">
                <t t-foreach="docs" t-as="packaging">
                    <div style="width:3in;border:1px solid #000;">
                        <div class="row">
                            <div class="text-center col-9" >
                                <strong><span t-field="packaging.company_id.name"/></strong>
                            </div>
                            <div class="col-3"><span t-field="packaging.product_id.size_id.name"/></div>
                        </div>
                        <div style="margin-left:5px; margin-bottom:0; padding-bottom:0; font-weight:bold;">
                            <span t-field="packaging.product_id.brand_id.name"/>
                        </div>

                        <div class="row" style="margin-top:0; padding-top:0;">
                            <div class="col-9" style="margin-left:15px; padding-top:0;">
                                <span t-field="packaging.product_id.name"/>
                            </div>
                            <div class="col-3">
                                <span t-field="packaging.product_id.default_code"/>
                            </div>
                        </div>
                        <div class="row" style="margin-top:0; padding-top:0;">
                            <div class="col-5" style="margin-left:5px; padding-top:0;">
                                <span t-field="packaging.product_id.barcode"/>
                            </div>
                            <div class="col-2">
                                <span t-esc="int(packaging.uom_id.relative_factor)"/>
                            </div>
                            <div class="col-5" style="margin-left:5px; padding-top:0;">
                                <strong>Rs <span t-esc="int(packaging.product_id.list_price)"/></strong>
                            </div>
                        </div>
                        <div style="flex:1;text-align:center;">
                            <div t-field="packaging.barcode"
                             t-options="{
                                'widget':'barcode',
                                'symbology':'auto',
                                'width':250,
                                'height':50
                             }"/>
                            <div class="text-center">
                                <span t-field="packaging.barcode"/>
                            </div>
                        </div>
                    </div>

                </t>

            </div>

        </xpath>

    </template>

</odoo>