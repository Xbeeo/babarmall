<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report action: appears under Print -> Custom Purchase Order -->
    <record id="action_report_custom_purchaseorder" model="ir.actions.report">
        <field name="name">Custom Purchase Order</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">xbo_abm_report.report_custom_purchaseorder</field>
        <field name="report_file">xbo_abm_report.report_custom_purchaseorder</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Custom Purchase Order - %s' % (object.name)</field>
    </record>

    <template id="report_custom_purchaseorder">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            .custom-po-table, .custom-po-table th, .custom-po-table td {
                            border: 1px solid black !important;
                            }
                            .custom-po-table {
                            width: 100%;
                            border-collapse: collapse;
                            }
                        </style>

                        <!-- Addresses -->
                        <div class="row mt-3">
                            <div class="col-6">
                                <strong>Shipping address</strong>
                                <t t-if="o.dest_address_id">
                                    <div t-field="o.dest_address_id"
                                         t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True}'/>
                                </t>
                                <t t-else="">
                                    <div t-field="o.picking_type_id.warehouse_id.partner_id"
                                         t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True}'/>
                                </t>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Vendor</strong>
                                <div>
                                    <t t-esc="o.partner_id.name"/>
                                </div>
                                <div t-if="o.partner_id.country_id">
                                    <t t-esc="o.partner_id.country_id.name"/>
                                </div>
                                <div t-if="o.partner_id.phone">
                                    <t t-esc="o.partner_id.phone"/>
                                </div>
                            </div>
                        </div>

                        <!-- Title -->
                        <h2 class="mt-4">
                            <span t-if="o.state in ('draft', 'sent', 'to approve')">Request for Quotation #</span>
                            <span t-else="">Purchase Order #</span>
                            <span t-field="o.name"/>
                        </h2>

                        <!-- Info -->
                        <div class="row mt-3 mb-3">
                            <div t-if="o.user_id" class="col-3">
                                <strong>Buyer:</strong>
                                <div t-field="o.user_id"/>
                            </div>
                            <div class="col-3">
                                <strong>Your Order Reference</strong>
                                <div t-field="o.partner_ref"/>
                            </div>
                            <div t-if="o.date_order" class="col-3">
                                <strong>Order Date:</strong>
                                <div t-esc="o.date_order.strftime('%d %b %Y')"/>
                            </div>
                            <div t-if="o.date_planned" class="col-3">
                                <strong>Expected Arrival:</strong>
                                <div t-esc="o.date_planned.strftime('%d %b %Y')"/>
                            </div>
                        </div>

                        <!-- Lines -->
                        <t t-set="sr_no" t-value="0"/>
                        <t t-set="total_qty" t-value="0"/>
                        <t t-set="total_sale_value" t-value="0"/>
                        <table class="custom-po-table table table-sm o_main_table">
                            <thead style="display: table-row-group">
                                <tr>
                                    <th class="text-start fw-bold">Sr. #</th>
                                    <th class="text-start fw-bold">Barcode</th>
                                    <th class="text-start fw-bold">Description</th>
                                    <th class="text-end fw-bold">Qty</th>
                                    <th class="text-end fw-bold">Unit Price</th>
                                    <th class="text-end fw-bold">Sales Price</th>
                                    <th class="text-end fw-bold">Margin %</th>
                                    <th class="text-end fw-bold">Disc.%</th>
                                    <th class="text-end fw-bold">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.order_line" t-as="line">
                                    <tr t-att-class="'fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                        <t t-if="not line.display_type">
                                            <t t-set="sr_no" t-value="sr_no + 1"/>
                                            <t t-set="total_qty" t-value="total_qty + line.product_qty"/>
                                            <t t-set="total_sale_value" t-value="total_sale_value + (line.product_qty*line.sale_price)"/>
                                            <t t-set="product" t-value="line.product_id"/>
                                            <t t-set="desc_parts"
                                               t-value="[p for p in [
                                                product.default_code,
                                                product.name,
                                                product.brand_id.name,
                                                product.size_id.name,
                                                product.color_id.name] if p]"/>
                                            <td class="text-start">
                                                <span t-esc="sr_no"/>
                                            </td>
                                            <td class="text-start">
                                                <span t-esc="line.item_code"/>
                                            </td>
                                            <td>
                                                <span t-esc="' - '.join(desc_parts)"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="line.product_qty"/>
                                                <span t-field="line.product_uom_id.name" groups="uom.group_uom"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="line.price_unit"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="product.lst_price"
                                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="line.margin_percentage"
                                                      t-options='{"widget": "float", "precision": 2}'/>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="line.discount" t-options='{"widget": "float", "precision": 2}'/>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="line.price_subtotal"
                                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </t>
                                        <t t-elif="line.display_type == 'line_section'">
                                            <td colspan="7">
                                                <span t-field="line.name"/>
                                            </td>
                                        </t>
                                        <t t-elif="line.display_type == 'line_note'">
                                            <td colspan="7">
                                                <span t-field="line.name"/>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                                <!-- Totals row -->
                                <tr class="fw-bold">
                                    <td/>
                                    <td/>
                                    <td class="text-end">Total</td>
                                    <td class="text-end">
                                        <span t-esc="total_qty"/>
                                    </td>
                                    <td colspan="4"/>
                                    <td class="text-end">
                                        <span t-esc="sum(l.price_subtotal for l in o.order_line if not l.display_type)"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                                <tr class="fw-bold">
                                    <td/>
                                    <td/>
                                    <td class="text-end">Sale Value</td>
                                    <td colspan="5"/>
                                    <td class="text-end">
                                        <span t-esc="total_sale_value" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>

                            </tbody>
                        </table>

                        <p t-if="o.payment_term_id" class="mt-3">
                            <strong>Payment Terms:</strong>
                            <span t-field="o.payment_term_id.name"/>
                        </p>
                        <div t-if="not is_html_empty(o.note)" class="mt-3">
                            <span t-field="o.note"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>