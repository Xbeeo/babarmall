<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="custom_paperformat_report_02" model="report.paperformat">
            <field name="name">Custom A5 Portrait</field>
            <field name="default" eval="True"/>
            <field name="format">A5</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">30</field>
            <field name="header_spacing">25</field>
            <field name="margin_bottom">0</field>
            <field name="margin_left">1</field>
            <field name="margin_right">0</field>
            <field name="disable_shrinking" eval="True"/>
            <field name="dpi">90</field>
        </record>


        <record id="action_custom_report_saleorder" model="ir.actions.report">
            <field name="name">Custom Sale Order</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">xbo_abm_report.custom_sale_order_report_template</field>
            <field name="report_file">xbo_abm_report.custom_sale_order_report_template</field>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="custom_paperformat_report_02"/>
            <field name="print_report_name">(object.state in ('draft', 'sent') and 'Quotation - %s' % (object.name)) or 'Order - %s' % (object.name)</field>
        </record>

        <record id="action_custom_invoice_report" model="ir.actions.report">
            <field name="name">Custom Invoice</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">xbo_abm_report.action_custom_invoice_report_template</field>
            <field name="report_file">xbo_abm_report.action_custom_invoice_report_template</field>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
            <field name="print_report_name">(object._get_report_base_filename())</field>
             <field name="paperformat_id" ref="custom_paperformat_report_02"/>
             <field name="domain">[('move_type', '=', 'out_invoice')]</field>
        </record>


    </data>
</odoo>