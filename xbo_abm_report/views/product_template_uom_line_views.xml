<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_product_template_uom_line_list_inherit" model="ir.ui.view">
        <field name="name">product.template.uom.line.list.inherit</field>
        <field name="model">product.template.uom.line</field>
        <field name="inherit_id" ref="xbo_abm_custom.view_product_template_uom_line_list"/>
        <field name="arch" type="xml">

            <xpath expr="//list" position="inside">
                <header>
                    <button name="action_open_print_wizard"
                            type="object"
                            string="Print Barcode"
                            class="btn-primary"/>
                </header>
            </xpath>
        </field>
    </record>

</odoo>