<odoo>
    <record id="view_bad_debt_report_wizard" model="ir.ui.view">
        <field name="name">bad.debt.report.wizard.form</field>
        <field name="model">bad.debt.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="partner_id"/>
                </group>
                <footer>
                    <button string="Print" name="action_print" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_bad_debt_report_wizard" model="ir.actions.act_window">
        <field name="name">Bad Debt Report</field>
        <field name="res_model">bad.debt.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>