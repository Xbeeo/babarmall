<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_uom_line_print_wizard_form" model="ir.ui.view">
        <field name="name">uom.line.print.wizard.form</field>
        <field name="model">uom.line.print.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="qty"/>
                </group>
                <field name="line_ids" readonly="1">
                    <list>
                        <field name="product_tmpl_id"/>
                        <field name="uom_id"/>
                        <field name="print_qty"/>
                    </list>
                </field>
                <footer>
                    <button name="action_print" type="object"
                            string="Print" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>