<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_purchase_order_form_inherit_location" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.location</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//list//field[@name='product_id']"
                   position="after">
                <button name="action_open_warehouse_wizard"
                    type="object"
                    string="Tracking WH"
                    icon="fa-home"/>
<!--                <field name="warehouse_location_ids" widget="many2many_tags"/>-->
            </xpath>
        </field>
    </record>
</odoo>
