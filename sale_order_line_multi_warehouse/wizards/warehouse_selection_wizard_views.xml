<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>

        <record id="warehouse_selection_wizard_form_view" model="ir.ui.view">
            <field name="name">warehouse.selection.wizard.form</field>
            <field name="model">warehouse.selection.wizard</field>
            <field name="arch" type="xml">
                <form string="Product Warehouses &amp; Invoices">
                    <group>

                        <group>
                            <field name="product_id" readonly="1"/>
                        </group>

                        <group>
                            <field name="partner_id" readonly="1"/>
                        </group>

                    </group>


                    <separator string="Warehouse Location"/>
                    <field name="line_ids" nolabel="1" readonly="1">

                        <list create="false" delete="false">
                            <field name="location_id" readonly="1"/>
                            <field name="qty_available" readonly="1"/>
                        </list>

                    </field>
                     <separator string="Invoices" invisible="move_type != 'out_invoice'"/>
                     <separator string="Bills" invisible="move_type != 'in_invoice'"/>
                     <field name="invoice_line_ids" nolabel="1" readonly="1" invisible="move_type == 'internal'" >
                        <list create="false" delete="false">
                            <field name="move_id" string="Number"/>
                            <field name="partner_id"/>
                            <field name="invoice_date"/>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="price_unit"/>
                            <field name="tax_ids"/>
                            <field name="price_subtotal"/>
                            <field name="price_total"/>
                        </list>
                    </field>
                    <footer>
                        <button string="Cancel"
                                special="cancel"/>

                    </footer>

                </form>
            </field>
        </record>
    </data>
</odoo>