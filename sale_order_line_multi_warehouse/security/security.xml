<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="stock_location_use_access_rule" model="ir.rule">
            <field name="name">Stock Location Access</field>
            <field name="model_id" ref="stock.model_stock_location"/>
            <field name="domain_force">
                [('id', 'in', user.allowed_location_id.ids)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

         <record id="stock_location_admi_access_rule" model="ir.rule">
            <field name="name">Stock Location admin Access</field>
            <field name="model_id" ref="stock.model_stock_location"/>
            <field name="domain_force">
                []
            </field>
            <field name="groups" eval="[(4, ref('base.group_erp_manager'))]"/>
        </record>

    </data>
</odoo>